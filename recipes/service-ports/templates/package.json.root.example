{
  "name": "<project-slug>",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "goliath": {
    "project": "<project-slug>"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* dev",
    "build": "pnpm -r --filter=./apps/* --filter=./packages/* build",
    "start": "pnpm -r --parallel --filter=./apps/* start",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
