{
  "name": "@<project-slug>/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "goliath": {
    "role": "backend",
    "name": "server",
    "canonicalPort": 4455,
    "framework": "hono"
  },
  "scripts": {
    "dev": "node ../../scripts/service-ports.mjs -- vite-node --watch src/index.ts",
    "build": "tsc",
    "start": "node ../../scripts/service-ports.mjs --start -- tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  }
}
